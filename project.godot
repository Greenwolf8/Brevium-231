;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Brevium-231"
run/main_scene="uid://1sl6oqalns15"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://Misc/icon.svg"

[audio]

buses/default_bus_layout="res://Misc/default_bus_layout.tres"

[autoload]

Global="*res://Scripts/Global.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=720
window/size/mode=2
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

